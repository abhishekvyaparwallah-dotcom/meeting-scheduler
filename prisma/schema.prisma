generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TELECALLER
}

enum ClientType {
  Doctor
  Teacher
  Retailer
  Real_Estate
  Manufacturer
  Others
}

enum CallDisposition {
  NEW
  CONNECTED
  BUSY
  CALL_CUT
  CALLBACK
  NOT_INTERESTED
  MEETING_BOOKED
}

enum MeetingStatus {
  scheduled
  completed
  cancelled
}

enum AuditActionType {
  CREATE_MEETING
  UPDATE_MEETING
  CANCEL_MEETING
  UPDATE_LEAD_STATUS
  ASSIGN_LEADS
  CONVERT_CLIENT
  CREATE_USER
  DELETE_USER
  LOGIN
}

model User {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TELECALLER)
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  meetingsAssigned Meeting[]     @relation("MeetingsAssigned")
  leadsAssigned    CallingLead[] @relation("LeadsAssigned")
  auditLogs        AuditLog[]
}

model CallingLead {
  id                 String          @id @default(cuid())
  clientName         String
  clientType         ClientType      @default(Others)
  phone              String
  city               String
  status             CallDisposition @default(NEW)
  callbackTime       String?
  notes              String?
  assignedEmployeeId String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  assignedEmployee   User            @relation("LeadsAssigned", fields: [assignedEmployeeId], references: [employeeId])
  meetings           Meeting[]
}

model Meeting {
  id                  String        @id @default(cuid())
  date                String
  time                String
  clientName          String
  clientType          ClientType    @default(Others)
  phone               String
  businessAddress     String
  mapsLink            String?
  notes               String?
  status              MeetingStatus @default(scheduled)
  convertedToClient   Boolean       @default(false)
  dealAmount          Int?
  contractDuration    String?
  acquisitionExpense  Int?
  nextFollowUp        String?
  assignedEmployeeId  String
  createdByEmployeeId String?
  leadId              String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  assignedEmployee    User          @relation("MeetingsAssigned", fields: [assignedEmployeeId], references: [employeeId])
  lead                CallingLead?  @relation(fields: [leadId], references: [id])
  clients             ClientConversion[]
}

model ClientConversion {
  id                 String   @id @default(cuid())
  meetingId          String   @unique
  clientName         String
  phone              String
  businessAddress    String
  dealAmount         Int
  contractDuration   String
  acquisitionExpense Int
  nextFollowUp       String
  convertedAt        DateTime @default(now())

  meeting            Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String          @id @default(cuid())
  employeeId   String
  employeeName String
  actionType   AuditActionType
  entityType   String
  entityId     String?
  details      String
  createdAt    DateTime        @default(now())

  user         User            @relation(fields: [employeeId], references: [employeeId])
}
