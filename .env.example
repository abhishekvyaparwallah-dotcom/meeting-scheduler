# ==============================================================
# VYAPAR WALLAH — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================

# --------------------------------------------------------------
# 🍃 MONGODB DATABASE CONFIGURATION
# --------------------------------------------------------------
# Cloud MongoDB Atlas:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/vyapar_wallah?retryWrites=true&w=majority"
# Local MongoDB:
MONGODB_URI="mongodb://127.0.0.1:27017/vyapar_wallah"

AUTH_SECRET="your-generated-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Fast2SMS Gateway (Optional SMS Alerts)
FAST2SMS_API_KEY="your-fast2sms-api-key"
FAST2SMS_SENDER_ID="FSTSMS"

# --------------------------------------------------------------
# 📧 ADMIN EMAIL NOTIFICATION SETUP (SMTP)
# --------------------------------------------------------------
ADMIN_NOTIFICATION_EMAIL="admin@vyaparwallah.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
EMAIL_FROM="\"Vyapar Wallah Alert\" <no-reply@vyaparwallah.com>"
