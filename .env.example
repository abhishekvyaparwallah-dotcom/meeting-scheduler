# ==========================================
# VYAPAR WALLAH - CONFIGURATION GUIDE
# ==========================================

# 1. MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vyapar_wallah?retryWrites=true&w=majority

# 2. NextAuth Security Key
AUTH_SECRET=vyapar-wallah-super-secret-production-key-change-this

# 3. NextAuth Public Site URL
NEXTAUTH_URL=http://localhost:3000

# ====================================================
# 4. BREVO (SENDINBLUE) FREE EMAIL SETUP (300 Free/Day)
# ====================================================
# Steps to get Brevo SMTP Keys:
# 1. Sign up on https://www.brevo.com (Free Account).
# 2. Go to top-right menu -> "SMTP & API" -> click "SMTP" tab.
# 3. Generate a new SMTP Master Key.
# 4. Fill the values below:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-login-email@gmail.com
SMTP_PASS=xsmtpsib-your-generated-brevo-smtp-key
EMAIL_FROM="Vyapar Wallah Security" <your-brevo-verified-sender@domain.com>

# Admin email where meeting alerts will be dispatched
ADMIN_NOTIFICATION_EMAIL=admin@vyaparwallah.com

# ----------------------------------------------------
# Alternative: Free Gmail SMTP (App Password)
# ----------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-app-password
# EMAIL_FROM="Vyapar Wallah Security" <your-email@gmail.com>
